{
  "name": "mode_voiture",
  "description": "Prépare le PC avant de prendre la route : règle le volume et ouvre Google Maps dans le navigateur.",
  "parameters": [
    {
      "name": "volume",
      "description": "Volume en pourcentage (0 à 100)",
      "required": false
    }
  ],
  "type": "routine",
  "steps": [
    {
      "tool": "device_settings",
      "args": {
        "setting": "volume",
        "value": "{volume}"
      }
    },
    {
      "tool": "open_app",
      "args": {
        "app_name": "Maps"
      }
    }
  ]
}
