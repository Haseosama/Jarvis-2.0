{
  "name": "mode_lecture",
  "description": "Prépare le PC pour lire : ajuste la luminosité de l’écran si elle est contrôlable et règle le volume.",
  "parameters": [
    {
      "name": "luminosite",
      "description": "Luminosité en pourcentage (0 à 100)",
      "required": true
    },
    {
      "name": "volume",
      "description": "Volume en pourcentage (0 à 100)",
      "required": true
    }
  ],
  "type": "routine",
  "steps": [
    {
      "tool": "device_settings",
      "args": {
        "setting": "brightness",
        "value": "{luminosite}"
      }
    },
    {
      "tool": "device_settings",
      "args": {
        "setting": "volume",
        "value": "{volume}"
      }
    }
  ]
}
