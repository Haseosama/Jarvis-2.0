{
  "name": "mode_sport",
  "description": "Prépare le PC pour le sport : règle le volume et lance/reprend la lecture multimédia.",
  "parameters": [
    {
      "name": "volume",
      "description": "Volume en pourcentage (0 à 100)",
      "required": true
    }
  ],
  "type": "routine",
  "steps": [
    {
      "tool": "device_settings",
      "args": {
        "setting": "volume",
        "value": "{volume}"
      }
    },
    {
      "tool": "device_settings",
      "args": {
        "action": "media",
        "command": "play"
      }
    }
  ]
}
